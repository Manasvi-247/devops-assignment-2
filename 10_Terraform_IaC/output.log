
$ terraform version
Terraform v1.16.4
on darwin_arm64

===== 1. The configuration =====

$ ls
main.tf
outputs.tf
terraform.tf
variables.tf

$ cat terraform.tf
terraform {
  required_version = ">= 1.5"
  required_providers {
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

$ cat main.tf
resource "random_pet" "suffix" {
  length = 2
}

resource "random_password" "api_key" {
  length  = 24
  special = false
}

# count turns one block into N resources, addressed as [0], [1], [2]
resource "local_file" "node_config" {
  count    = var.instance_count
  filename = "${path.module}/generated/node-${count.index}.conf"
  content  = <<-EOT
    # generated by terraform, do not edit
    project     = ${var.project_name}
    environment = ${var.environment}
    node_id     = ${count.index}
    cluster     = ${random_pet.suffix.id}
  EOT
}

resource "local_sensitive_file" "api_key" {
  filename = "${path.module}/generated/api-key.txt"
  content  = random_password.api_key.result
}

