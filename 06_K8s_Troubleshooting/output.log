broken-pending   1/1   Running   0     1s    10.244.2.52   svc-lab-worker2   <none>   <none>

===== 9. Drill: OOMKilled =====

$ kubectl apply -f manifests/08-oomkilled.yaml
pod/broken-oom created

$ kubectl -n triage get pod broken-oom --no-headers
broken-oom   0/1   OOMKilled   2 (21s ago)   25s

$ kubectl -n triage get pod broken-oom -o jsonpath='reason={.status.containerStatuses[0].lastState.terminated.reason} exitCode={.status.containerStatuses[0].lastState.terminated.exitCode}{"\n"}'
reason=OOMKilled exitCode=137
# it asked for 200M with a 64Mi limit. the kernel killed it, exit 137

$ kubectl -n triage delete pod broken-oom
pod "broken-oom" deleted from triage namespace

===== 10. Drill: service with no endpoints =====

$ kubectl apply -f manifests/05-broken-service.yaml
service/shop-broken created
# the service exists and looks fine

$ kubectl -n triage get svc shop-broken
NAME          TYPE        CLUSTER-IP     EXTERNAL-IP   PORT(S)   AGE
shop-broken   ClusterIP   10.96.177.92   <none>        80/TCP    5s
# DNS resolves, so this is not a DNS problem

$ kubectl -n triage exec triage-client -- nslookup shop-broken.triage.svc.cluster.local | tail -3
Name:	shop-broken.triage.svc.cluster.local
Address: 10.96.177.92

# but the request fails immediately

$ kubectl -n triage exec triage-client -- sh -c 'curl -s -m 5 http://shop-broken/ ; echo exit=$?'
exit=7
# the smoking gun: no endpoints

$ kubectl -n triage get endpointslices -l kubernetes.io/service-name=shop-broken
NAME                ADDRESSTYPE   PORTS     ENDPOINTS   AGE
shop-broken-s4ljv   IPv4          <unset>   <unset>     5s
# compare the selector with the pod labels

$ kubectl -n triage get svc shop-broken -o jsonpath='selector: {.spec.selector}{"\n"}'
selector: {"app":"shop","tier":"api"}

$ kubectl -n triage get pods -l app=shop --show-labels --no-headers
shop-6f575dbd46-bdmxd   1/1   Running   0     83s   app=shop,pod-template-hash=6f575dbd46,tier=web
shop-6f575dbd46-xpbpj   1/1   Running   0     83s   app=shop,pod-template-hash=6f575dbd46,tier=web
# tier=api vs tier=web. the fix:

$ kubectl apply -f manifests/05-broken-service-fixed.yaml
service/shop-broken configured

$ kubectl -n triage get endpointslices -l kubernetes.io/service-name=shop-broken
NAME                ADDRESSTYPE   PORTS   ENDPOINTS                 AGE
shop-broken-s4ljv   IPv4          8080    10.244.2.48,10.244.1.78   10s

$ kubectl -n triage exec triage-client -- curl -s http://shop-broken/ | head -2
Server address: 10.244.2.48:8080
Server name: shop-6f575dbd46-bdmxd

===== 11. Drill: endpoints exist but the port is wrong =====

$ kubectl apply -f manifests/06-wrong-targetport.yaml
service/shop-wrongport created
# endpoints are present, so the selector is fine

$ kubectl -n triage get endpointslices -l kubernetes.io/service-name=shop-wrongport
NAME                   ADDRESSTYPE   PORTS   ENDPOINTS                 AGE
shop-wrongport-ssdb4   IPv4          9999    10.244.2.48,10.244.1.78   5s
# yet it still fails, and with the SAME exit 7 as the empty service.
# the pod is reachable and actively refuses on a closed port, so curl
# gets a reset rather than a timeout. the exit code alone cannot tell
# these two faults apart, which is why you check the endpoint list.

$ kubectl -n triage exec triage-client -- sh -c 'curl -s -m 5 http://shop-wrongport/ ; echo exit=$?'
exit=7
# targetPort 9999, container listens on 8080

$ kubectl -n triage get svc shop-wrongport -o jsonpath='targetPort={.spec.ports[0].targetPort}{"\n"}'
targetPort=9999

$ kubectl -n triage get deploy shop -o jsonpath='containerPort={.spec.template.spec.containers[0].ports[0].containerPort}{"\n"}'
containerPort=8080

