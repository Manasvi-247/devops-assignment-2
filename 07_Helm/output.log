
$ helm version --short
v4.3.0+gbec5b06

$ kubectl create namespace helm-lab --dry-run=client -o yaml | kubectl apply -f -
namespace/helm-lab unchanged

===== 1. Chart structure =====

$ find notes-chart -type f | sort
notes-chart/.helmignore
notes-chart/Chart.yaml
notes-chart/templates/NOTES.txt
notes-chart/templates/_helpers.tpl
notes-chart/templates/deployment.yaml
notes-chart/templates/service.yaml
notes-chart/values-prod.yaml
notes-chart/values.yaml

$ cat notes-chart/Chart.yaml
apiVersion: v2
name: notes-chart
description: A notes app packaged as a Helm chart for the session 15 exercises
type: application
version: 0.1.0
appVersion: "1.0"
# lint before anything is installed

$ helm lint notes-chart
==> Linting notes-chart
[INFO] Chart.yaml: icon is recommended

1 chart(s) linted, 0 chart(s) failed

===== 2. Templating: values in, manifests out =====
# render locally without touching the cluster

$ helm template notes notes-chart | head -40
---
# Source: notes-chart/templates/service.yaml
apiVersion: v1
kind: Service
metadata:
  name: notes-notes-chart
  labels:
    app.kubernetes.io/name: notes-chart
    app.kubernetes.io/instance: notes
    app.kubernetes.io/version: "1.0"
    app.kubernetes.io/managed-by: Helm
    helm.sh/chart: notes-chart-0.1.0
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: notes-chart
    app.kubernetes.io/instance: notes
  ports:
    - name: http
      port: 80
      targetPort: http

---
# Source: notes-chart/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: notes-notes-chart
  labels:
    app.kubernetes.io/name: notes-chart
    app.kubernetes.io/instance: notes
    app.kubernetes.io/version: "1.0"
    app.kubernetes.io/managed-by: Helm
    helm.sh/chart: notes-chart-0.1.0
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: notes-chart
      app.kubernetes.io/instance: notes
# the same template with the production overlay, showing only what changed

$ diff <(helm template notes notes-chart) <(helm template notes notes-chart -f notes-chart/values-prod.yaml) | head -30
36c36
<   replicas: 2
---
>   replicas: 4
56c56
<               value: "development"
---
>               value: "production"
58c58
<               value: "notes app, default values"
---
>               value: "notes app, production overlay"
66,67c66,67
<               cpu: 100m
<               memory: 64Mi
---
>               cpu: 200m
>               memory: 128Mi
69,70c69,70
<               cpu: 25m
<               memory: 32Mi
---
>               cpu: 50m
>               memory: 64Mi

===== 3. Install =====

$ helm install notes notes-chart -n helm-lab --wait --timeout 5m
NAME: notes
LAST DEPLOYED: Wed Oct  7 20:43:14 2026
NAMESPACE: helm-lab
STATUS: deployed
REVISION: 1
DESCRIPTION: Install complete
TEST SUITE: None
NOTES:
notes-chart 0.1.0 installed as release "notes".

Environment: development
Replicas:    2

Reach it from inside the cluster:

  kubectl -n helm-lab run tmp --rm -it --image=curlimages/curl:8.7.1 --restart=Never -- \
    curl -s http://notes-notes-chart:80

$ helm list -n helm-lab
