===== 5. Path based routing with rewrite =====
# ingress controller ClusterIP: 10.96.191.177

$ kubectl -n app-config get ingress yatri-ingress
NAME            CLASS   HOSTS         ADDRESS   PORTS   AGE
yatri-ingress   nginx   yatri.local             80      11s

$ kubectl -n app-config describe ingress yatri-ingress | sed -n '/Rules:/,/Annotations/p'
Rules:
  Host         Path  Backends
  ----         ----  --------
  yatri.local  
               /api(/|$)(.*)   yatri-backend:80 (10.244.1.74:8080,10.244.2.70:8080)
               /               yatri-frontend:80 (10.244.1.72:8080,10.244.2.68:8080)
Annotations:   nginx.ingress.kubernetes.io/rewrite-target: /$2
# / goes to the frontend:

$ kubectl -n app-config exec probe -- curl -s -H 'Host: yatri.local' http://10.96.191.177/
YATRI FRONTEND SITE | uri=/
# /api/ goes to the backend, with the /api prefix rewritten away:

$ kubectl -n app-config exec probe -- curl -s -H 'Host: yatri.local' http://10.96.191.177/api/
YATRI BACKEND API | uri=/

$ kubectl -n app-config exec probe -- curl -s -H 'Host: yatri.local' http://10.96.191.177/api/bookings
YATRI BACKEND API | uri=/bookings

