===== 1. The base64 trailing newline bug =====
# this is a shell level gotcha, no cluster involved

$ echo 'secretpassword' | xxd | tail -2
00000000: 7365 6372 6574 7061 7373 776f 7264 0a    secretpassword.

$ echo -n 'secretpassword' | xxd | tail -2
00000000: 7365 6372 6574 7061 7373 776f 7264       secretpassword
# the first ends 0a, which is a newline. the encodings differ:

$ echo 'secretpassword' | base64
c2VjcmV0cGFzc3dvcmQK

$ echo -n 'secretpassword' | base64
c2VjcmV0cGFzc3dvcmQ=
# decoding both back, piped to xxd so the difference is visible:

$ echo 'c2VjcmV0cGFzc3dvcmRL' >/dev/null; echo 'secretpassword' | base64 | base64 -d | xxd | tail -1
00000000: 7365 6372 6574 7061 7373 776f 7264 0a    secretpassword.

$ echo -n 'secretpassword' | base64 | base64 -d | xxd | tail -1
00000000: 7365 6372 6574 7061 7373 776f 7264       secretpassword

