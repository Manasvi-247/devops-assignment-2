===== 1. The stack definition =====

$ docker compose config --services
postgres
backend
frontend
# an override file moves the host ports, see docker-compose.override.yml

$ docker compose config | grep -A3 published || true
        published: "18000"
        protocol: tcp
    restart: unless-stopped
  frontend:
--
        published: "13000"
        protocol: tcp
  postgres:
    environment:
--
        published: "15432"
        protocol: tcp
    volumes:
      - type: volume

$ cat docker-compose.yml
services:
  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: taskboard
      POSTGRES_USER: taskboard
      POSTGRES_PASSWORD: taskboard
    ports:
      - "5432:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data

  backend:
    build: ./backend
    environment:
      DATABASE_URL: postgresql+psycopg://taskboard:taskboard@postgres:5432/taskboard
    depends_on:
      - postgres
    ports:
      - "8000:8000"

  frontend:
    build: ./frontend
    depends_on:
      - backend
    ports:
      - "3000:80"

volumes:
  postgres-data:

