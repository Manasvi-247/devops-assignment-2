4         <none>


===== 8. DaemonSet: exactly one pod per worker node =====

$ kubectl apply -f manifests/05-daemonset.yaml
daemonset.apps/node-agent created

$ kubectl -n workloads rollout status daemonset/node-agent --timeout=180s
Waiting for daemon set "node-agent" rollout to finish: 0 of 2 updated pods are available...
daemon set "node-agent" successfully rolled out

$ kubectl -n workloads get daemonset node-agent
NAME         DESIRED   CURRENT   READY   UP-TO-DATE   AVAILABLE   NODE SELECTOR   AGE
node-agent   2         2         2       2            2           <none>          1s

$ kubectl -n workloads get pods -l app=node-agent -o custom-columns=POD:.metadata.name,NODE:.spec.nodeName
POD                NODE
node-agent-42w89   svc-lab-worker
node-agent-chbld   svc-lab-worker2
# for comparison, the nodes in the cluster:

$ kubectl get nodes
NAME                    STATUS   ROLES           AGE   VERSION
svc-lab-control-plane   Ready    control-plane   22m   v1.37.0
svc-lab-worker          Ready    <none>          22m   v1.37.0
svc-lab-worker2         Ready    <none>          22m   v1.37.0

