$ kubectl -n svc-lab exec curl-box -- nslookup web-stateful-0.web-headless.svc-lab.svc.cluster.local | tail -3
Name:	web-stateful-0.web-headless.svc-lab.svc.cluster.local
Address: 10.244.1.63


$ kubectl -n svc-lab exec curl-box -- nslookup web-stateful-1.web-headless.svc-lab.svc.cluster.local | tail -3
Name:	web-stateful-1.web-headless.svc-lab.svc.cluster.local
Address: 10.244.2.62


$ kubectl -n svc-lab exec curl-box -- nslookup web-stateful-2.web-headless.svc-lab.svc.cluster.local | tail -3
Name:	web-stateful-2.web-headless.svc-lab.svc.cluster.local
Address: 10.244.1.64

# addressing one specific pod by name, which a ClusterIP cannot do:

$ kubectl -n svc-lab exec curl-box -- curl -s http://web-stateful-0.web-headless:80 | head -2
command terminated with exit code 7
# the name is stable across deletion: delete web-stateful-0 and re-resolve

$ kubectl -n svc-lab get pod web-stateful-0 -o jsonpath='before: {.status.podIP}{"\n"}'
before: 10.244.1.63

$ kubectl -n svc-lab delete pod web-stateful-0
pod "web-stateful-0" deleted from svc-lab namespace

$ kubectl -n svc-lab wait --for=condition=Ready pod/web-stateful-0 --timeout=180s
pod/web-stateful-0 condition met

$ kubectl -n svc-lab get pod web-stateful-0 -o jsonpath='after:  {.status.podIP}{"\n"}'
after:  10.244.1.65

$ kubectl -n svc-lab exec curl-box -- curl -s http://web-stateful-0.web-headless:80 | head -2
command terminated with exit code 7
# headless services DO still have endpoints, they just are not fronted by a VIP:

$ kubectl -n svc-lab get endpointslices -l kubernetes.io/service-name=web-headless
NAME                 ADDRESSTYPE   PORTS   ENDPOINTS                             AGE
web-headless-sx67b   IPv4          8080    10.244.2.62,10.244.1.64,10.244.1.65   18s

===== 5. A Service with no selector, endpoints written by hand =====

$ kubectl apply -f manifests/06-no-selector/service.yaml
service/external-legacy-db created
endpointslice.discovery.k8s.io/external-legacy-db-manual created

$ kubectl -n svc-lab get svc external-legacy-db
NAME                 TYPE        CLUSTER-IP     EXTERNAL-IP   PORT(S)    AGE
external-legacy-db   ClusterIP   10.96.13.232   <none>        3306/TCP   0s

$ kubectl -n svc-lab get svc external-legacy-db -o jsonpath='selector={.spec.selector}{"\n"}'
selector=
# the selector is empty, so nothing populates endpoints automatically.
# the EndpointSlice applied alongside it was written by hand:

$ kubectl -n svc-lab get endpointslices -l kubernetes.io/service-name=external-legacy-db
NAME                        ADDRESSTYPE   PORTS   ENDPOINTS       AGE
external-legacy-db-manual   IPv4          3306    192.168.1.150   0s

$ kubectl -n svc-lab get endpointslice external-legacy-db-manual -o jsonpath='address={.endpoints[0].addresses[0]} port={.ports[0].port}{"\n"}'
address=192.168.1.150 port=3306
# the in-cluster DNS name now points at infrastructure outside the cluster.
# 192.168.1.150 does not exist on this network, so a connection just times
# out, but the abstraction is the point: pods use one name either way.

$ kubectl -n svc-lab exec curl-box -- nslookup external-legacy-db.svc-lab.svc.cluster.local | tail -3
Name:	external-legacy-db.svc-lab.svc.cluster.local
Address: 10.96.13.232


