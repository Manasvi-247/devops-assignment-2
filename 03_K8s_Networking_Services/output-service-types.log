$ kubectl -n svc-lab get pods -l app=web-stateful -o wide
NAME             READY   STATUS    RESTARTS   AGE   IP            NODE              NOMINATED NODE   READINESS GATES
web-stateful-0   1/1     Running   0          12s   10.244.1.63   svc-lab-worker    <none>           <none>
web-stateful-1   1/1     Running   0          9s    10.244.2.62   svc-lab-worker2   <none>           <none>
web-stateful-2   1/1     Running   0          5s    10.244.1.64   svc-lab-worker    <none>           <none>

