
$ kubectl apply -f manifests/01-clusterip/
namespace/svc-lab unchanged
deployment.apps/hello-api unchanged
service/hello-api-svc unchanged
pod/curl-box unchanged

$ kubectl -n svc-lab rollout status deployment/hello-api --timeout=180s
deployment "hello-api" successfully rolled out

===== 1. NodePort =====

$ kubectl apply -f manifests/02-nodeport/service.yaml
service/hello-api-nodeport created
# giving kube-proxy a moment to program the rules on every node

$ kubectl -n svc-lab get svc hello-api-nodeport
NAME                 TYPE       CLUSTER-IP      EXTERNAL-IP   PORT(S)          AGE
hello-api-nodeport   NodePort   10.96.119.216   <none>        9090:30080/TCP   11s
# PORT(S) reads 9090:30080/TCP: service port 9090, node port 30080
# a NodePort still has a ClusterIP, it is a superset of ClusterIP:

$ kubectl -n svc-lab get svc hello-api-nodeport -o jsonpath='type={.spec.type} clusterIP={.spec.clusterIP} nodePort={.spec.ports[0].nodePort}{"\n"}'
type=NodePort clusterIP=10.96.119.216 nodePort=30080
# the port is open on EVERY node, not just the ones running pods.
# curling each node from inside its own container:

$ docker exec svc-lab-control-plane curl -s -m 5 http://localhost:30080 | head -2
Server address: 10.244.2.6:8080
Server name: hello-api-6ddb65475c-j2vds

$ docker exec svc-lab-worker curl -s -m 5 http://localhost:30080 | head -2
Server address: 10.244.1.4:8080
Server name: hello-api-6ddb65475c-tl64v

$ docker exec svc-lab-worker2 curl -s -m 5 http://localhost:30080 | head -2
Server address: 10.244.2.6:8080
Server name: hello-api-6ddb65475c-j2vds
# and from one node to another node's IP, to prove it is not node local:

$ docker exec svc-lab-worker curl -s -m 5 http://172.22.0.3:30080 | head -2
Server address: 10.244.2.6:8080
Server name: hello-api-6ddb65475c-j2vds
# from the Mac itself it is NOT reachable: kind runs nodes as containers
# and this cluster was created without extraPortMappings for 30080.

$ curl -s -m 5 http://localhost:30080 || echo 'failed as expected from the host'
failed as expected from the host

===== 2. LoadBalancer =====

$ kubectl apply -f manifests/03-loadbalancer/service.yaml
service/hello-api-lb created

$ kubectl -n svc-lab get svc hello-api-lb
NAME           TYPE           CLUSTER-IP     EXTERNAL-IP   PORT(S)        AGE
hello-api-lb   LoadBalancer   10.96.28.115   <pending>     80:30081/TCP   5s
# EXTERNAL-IP is <pending> and stays that way: no cloud controller exists
# on a local cluster to answer the request. on EKS/GKE/AKS this is where
# a real load balancer would be provisioned and its IP written back.

$ kubectl -n svc-lab describe svc hello-api-lb | grep -E 'Type|IP:|Port|NodePort|Endpoints|Events' 
Type:                     LoadBalancer
IP:                       10.96.28.115
Port:                     http  80/TCP
TargetPort:               http/TCP
NodePort:                 http  30081/TCP
Endpoints:                10.244.1.4:8080,10.244.2.5:8080,10.244.2.6:8080
Events:                   <none>
# the inner layers still work. the NodePort it allocated:

$ docker exec svc-lab-worker curl -s -m 5 http://localhost:30081 | head -2
Server address: 10.244.2.5:8080
Server name: hello-api-6ddb65475c-c2hlm
# and its ClusterIP:

$ kubectl -n svc-lab exec curl-box -- curl -s -m 5 http://10.96.28.115/ | head -2
Server address: 10.244.1.4:8080
Server name: hello-api-6ddb65475c-tl64v

===== 3. ExternalName =====

$ kubectl apply -f manifests/04-externalname/service.yaml
